# Copy this file to .env. Never commit .env.

# Gemini API
GEMINI_API_KEY=

# The fixed date the demo treats as today
DEMO_TODAY=2026-11-09

# Name shown in the app and on documents
DOCTOR_NAME=Dr. Ahmed Raza

# Minutes between automatic alert checks. 0 turns them off.
AUTOMATION_INTERVAL_MINUTES=15

# Optional: a service you control that sends real WhatsApp or SMS messages
ALERT_WEBHOOK_URL=

# Optional: this computer's network address, to scan QR codes from a phone
PUBLIC_URL=
